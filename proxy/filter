# airlock egress whitelist — one extended-regex per line, matched against the
# destination HOST. Anything not listed here is BLOCKED for the sandbox.
# Add domains with:  airlock allow <domain>   (or edit this file; the
# proxy re-reads it on restart — no rebuild). Match is on the HOST only: never
# put a port, scheme or path in a rule.
# Lines starting with # are comments.

# --- package registries (so projects can install deps) ---
\.npmjs\.org$
^registry\.yarnpkg\.com$
\.yarnpkg\.com$
\.pypi\.org$
^pypi\.org$
\.pythonhosted\.org$
^crates\.io$
\.crates\.io$
^static\.crates\.io$

# --- source / git hosting ---
^github\.com$
\.github\.com$
\.githubusercontent\.com$
^codeload\.github\.com$
\.gitlab\.com$

# --- deploy targets ---
\.vercel\.com$
^vercel\.com$
\.herokuapp\.com$
\.heroku\.com$
\.netlify\.com$
\.netlify\.app$
\.cloudflare\.com$
\.workers\.dev$
\.firebaseio\.com$
\.googleapis\.com$

# --- Claude / Anthropic (applies in `run`; `dev` has full internet) ---
\.anthropic\.com$
^api\.anthropic\.com$
# OAuth: authorize page, token exchange/refresh, client metadata.
# Without these the mounted host token cannot refresh and Claude falls back
# to an interactive /login inside the sandbox.
^claude\.ai$
\.claude\.ai$
^claude\.com$
^platform\.claude\.com$

# --- common runtime downloads (things that broke ordinary projects) ---
# Node binaries for `nvm install <ver>`.
^nodejs\.org$
# next/font/google fetches font files from here at dev/build time.
^fonts\.gstatic\.com$

# --- Sanity CMS ---
# These were added as "api.sanity.io:443", which never matched: the proxy
# compares the HOST ONLY, without the port. `airlock allow` now strips ports.
^api\.sanity\.io$
\.api\.sanity\.io$
\.apicdn\.sanity\.io$
^cdn\.sanity\.io$
