#!/usr/bin/env bash
# airlock — a disposable, hardened Linux sandbox for running untrusted code and
# deploying with throwaway CLI logins. Two modes:
#
#   airlock run [CMD]   UNTRUSTED mode: no host secrets, locked-down, egress
#                       only through a domain whitelist proxy. For OSS you don't
#                       trust. (alias: `airlock shell`)
#   airlock dev [CMD]   TRUSTED mode: your Claude login works, full internet,
#                       and Claude history/memory are your Mac's ~/.claude.
#                       For your own code.
#   airlock sbx [CMD]   Docker microVM mode. NOTE: `docker sandbox` was removed
#                       from Docker Desktop; this exits with guidance if the
#                       subcommand is unavailable.
#
#   airlock exec [CMD]  open ANOTHER terminal into the running sandbox
#   airlock allow DOM   add a domain to the egress whitelist (reloads the proxy)
#   airlock reset [CL]  wipe a client's persistent home volume
#   airlock login       store a long-lived Claude token (no "Login expired")
#   airlock logout      remove it again
#   airlock down        stop & remove this project's sandbox + proxy
#   airlock off         stop everything and quit Docker Desktop (frees its RAM)
#   airlock status      show images, running containers, whitelist
#   airlock build       (re)build the images
#   airlock rebuild     rebuild from scratch (no cache)
#   airlock logs        follow proxy logs (see what egress is allowed/blocked)
#   airlock help        this help   (also: --help, -h)
#
# MULTI-CLIENT MODEL
#   Each PROJECT gets its own compose project -> its own proxy, its own
#   isolated network, and its own hashed host ports, so two client sandboxes
#   run side by side without clashing.
#   Each CLIENT gets its own /home/node volume -> caches and Claude history
#   persist per client and never leak between them. The client is resolved
#   from $AIRLOCK_CLIENT, else a .airlock-client file in the project, else the
#   name of the project's parent directory.
set -euo pipefail

# Directory you invoked airlock from -> mounted at the same path inside
# (both modes, so Claude sessions are filed per project). Capture before cd.
INVOKE_DIR="$PWD"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

SANDBOX_IMAGE="syedtasavour/airlock-sandbox:latest"
PROXY_IMAGE="syedtasavour/airlock-proxy:latest"
FILTER="$DIR/proxy/filter"
# Host-side bookkeeping: when each home volume was last used, the last
# auto-clean, the disk warning shown in the banner. Git-ignored.
STATE_DIR="$DIR/.state"

# Colors (disabled when output isn't a terminal, e.g. piped).
if [ -t 1 ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'
  C=$'\033[36m'; R=$'\033[31m'; N=$'\033[0m'
else
  B=""; DIM=""; G=""; Y=""; C=""; R=""; N=""
fi
hr() { printf '  %s\n' "${DIM}────────────────────────────────────────────────────${N}"; }

# Turn the proxy regex filter into human-readable domains:
#   \.npmjs\.org$ -> *.npmjs.org      ^github\.com$ -> github.com
readable_whitelist() {
  grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$FILTER" 2>/dev/null \
    | sed -E 's/\$$//; s/^\^//; s/^\\\./*./; s/\\\././g' | sort -u
}

# ---- compose plumbing ------------------------------------------------------
# The base file declares no /home/node mount; exactly one home override is
# always layered on top (see set_home_mode).
COMPOSE_FILES=(-f "$DIR/docker-compose.yml" -f "$DIR/docker-compose.home-persistent.yml")
HOME_MODE="persistent"

set_home_mode() {
  HOME_MODE="$1"
  if [ "$1" = "ephemeral" ]; then
    COMPOSE_FILES=(-f "$DIR/docker-compose.yml" -f "$DIR/docker-compose.home-ephemeral.yml")
  else
    COMPOSE_FILES=(-f "$DIR/docker-compose.yml" -f "$DIR/docker-compose.home-persistent.yml")
  fi
}

dc() { docker compose "${COMPOSE_FILES[@]}" "$@"; }
# Your Mac's time zone, so times inside (status line, `date`, logs) match it.
AIRLOCK_TZ="${TZ:-$(readlink /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')}"; export AIRLOCK_TZ
# Interactive shell inside the sandbox: zsh (same setup as your Mac), or bash
# in an image built before zsh was added.
SHELL_CMD=(sh -c 'exec "$(command -v zsh || command -v bash)"')
image_exists() { docker image inspect "$1" >/dev/null 2>&1; }
docker_running() { docker info >/dev/null 2>&1; }

# Start Docker Desktop if it's stopped (e.g. after `airlock off`), instead of
# failing with "Cannot connect to the Docker daemon".
ensure_docker() {
  docker_running && return 0
  echo "${DIM}› Docker isn't running — starting Docker Desktop…${N}"
  open -a Docker 2>/dev/null || { echo "${R}✗ couldn't start Docker Desktop${N}"; exit 1; }
  local i
  for i in $(seq 1 60); do
    sleep 2
    docker_running && return 0
  done
  echo "${R}✗ Docker didn't come up within 2 minutes${N}"
  exit 1
}

# $1 = run|dev. `dev` never touches the proxy, so a flaky alpine/apk pull
# must not abort it — that was a real intermittent failure of `airlock dev`.
ensure_built() {
  local mode="${1:-run}"
  if ! image_exists "$SANDBOX_IMAGE"; then
    echo "› sandbox image not found — building (first time only)…"
    dc --profile dev build dev
  fi
  if [ "$mode" = run ] && ! image_exists "$PROXY_IMAGE"; then
    echo "› proxy image not found — building…"
    dc --profile run build proxy
  fi
}

# ---- identity: client, project, ports --------------------------------------
# Lowercase and strip anything docker compose won't accept in a project name.
slugify() {
  echo "$1" | tr '[:upper:].' '[:lower:]-' \
    | sed 's/[^a-z0-9_-]/-/g; s/--*/-/g; s/^[-_]*//; s/[-_]*$//'
}

# Which client's home volume this project uses.
#   $AIRLOCK_CLIENT  >  .airlock-client in the project  >  parent dir name
resolve_client() {
  local c=""
  if [ -n "${AIRLOCK_CLIENT:-}" ]; then
    c="$AIRLOCK_CLIENT"
  elif [ -f "$INVOKE_DIR/.airlock-client" ]; then
    c="$(head -1 "$INVOKE_DIR/.airlock-client" 2>/dev/null || true)"
  else
    c="$(basename "$(dirname "$INVOKE_DIR")")"
  fi
  c="$(slugify "$c")"
  echo "${c:-default}"
}

# ---- ports -------------------------------------------------------------------
# Every well-known dev-server port is published, so whatever the project runs
# is reachable from your Mac with no config:
#   3000-3005  Next.js, CRA, Remix, Nuxt, Express, a 2nd/3rd app
#   4000 4200  Gatsby/Phoenix/GraphQL, Angular       4173  vite preview
#   4321       Astro                                 5000 5001  Flask, .NET, serve
#   5173-5175  Vite (and its next free ports)        6006  Storybook
#   8000       Django, FastAPI, Laravel              8080 8081  misc, Expo/Metro
#   8787       wrangler dev                          9000  misc
# Add your own for one project with a .airlock-ports file (space/newline
# separated), or everywhere with AIRLOCK_EXTRA_PORTS="7000 7001".
#
# Each port maps 1:1 (host 3000 = container 3000) when it's free on your Mac,
# so the URL a dev server prints is the URL that works. A port that's taken
# (another project's box, or e.g. macOS AirPlay on 5000) moves on its own to
# 1<port>, 2<port>, … (3000 -> 13000) — the others stay 1:1 — and the banner
# says which. Published on 127.0.0.1 only: your Mac can reach the box's dev
# servers; other machines on your Wi-Fi can't.
DEFAULT_PORTS="3000 3001 3002 3003 3004 3005 4000 4173 4200 4321 5000 5001 5173 5174 5175 6006 8000 8080 8081 8787 9000"

wanted_ports() {
  local list="${AIRLOCK_PORTS:-$DEFAULT_PORTS} ${AIRLOCK_EXTRA_PORTS:-}"
  [ -f "$INVOKE_DIR/.airlock-ports" ] && list="$list $(tr -c '0-9\n' ' ' < "$INVOKE_DIR/.airlock-ports")"
  printf '%s\n' $list | grep -E '^[0-9]+$' | awk '$1 >= 1 && $1 <= 65535' | sort -un | tr '\n' ' '
}

port_busy() { nc -z -w1 127.0.0.1 "$1" >/dev/null 2>&1; }

# Launch-time only. A taken host port makes `docker compose run` fail outright,
# so probe each one and move just the busy ones. Writes a compose override
# with the result and layers it on. Sets PORTS_ONE, PORTS_MOVED, PORTS_FIRST.
PORTS_ONE=""; PORTS_MOVED=""; PORTS_FIRST=""
plan_ports() {  # $1 = untrusted|dev
  local svc="$1" p h k file
  file="$STATE_DIR/ports/${COMPOSE_PROJECT_NAME}-${svc}.yml"
  mkdir -p "$STATE_DIR/ports"
  { echo "# generated by airlock at launch — do not edit"
    echo "services:"; echo "  ${svc}:"; echo "    ports:"
    for p in $(wanted_ports); do
      h=""
      if ! port_busy "$p"; then h="$p"
      else
        for k in 1 2 3 4 5; do
          [ $(( k * 10000 + p )) -le 65535 ] || break
          port_busy $(( k * 10000 + p )) || { h=$(( k * 10000 + p )); break; }
        done
      fi
      [ -n "$h" ] || continue   # nowhere free: leave this one out
      echo "      - \"127.0.0.1:${h}:${p}\""
      if [ "$h" = "$p" ]; then PORTS_ONE="$PORTS_ONE $p"; else PORTS_MOVED="${PORTS_MOVED} ${p}→${h}"; fi
      [ -n "$PORTS_FIRST" ] || PORTS_FIRST="$h"
    done
  } > "$file"
  COMPOSE_FILES+=(-f "$file")
  AIRLOCK_FORWARD_PORTS="$(wanted_ports | tr ' ' ',' | sed 's/,$//')"; export AIRLOCK_FORWARD_PORTS
}

# "3000 3001 3002 3003 4000" -> "3000-3003 4000"
compact_ports() {
  printf '%s\n' $1 | sort -n | awk '
    NR == 1 { s = e = $1; next }
    $1 == e + 1 { e = $1; next }
    { printf "%s ", (s == e ? s : s "-" e); s = e = $1 }
    END { if (NR) printf "%s", (s == e ? s : s "-" e) }'
}

# Safe for every command: never refuses, never mutates anything.
set_identity() {
  export WORKSPACE="$INVOKE_DIR"
  AIRLOCK_CLIENT="$(resolve_client)"; export AIRLOCK_CLIENT
  PROJECT_SLUG="$(slugify "$(basename "$INVOKE_DIR")")"
  COMPOSE_PROJECT_NAME="airlock-${PROJECT_SLUG:-ws}"
  export COMPOSE_PROJECT_NAME
}

# Adds the "don't mount my whole home directory" guard. run/dev/sbx only.
set_workspace() {
  if [ "$INVOKE_DIR" = "$HOME" ] || [ "$INVOKE_DIR" = "/" ]; then
    echo "${R}✗ refusing to mount '$INVOKE_DIR' (too broad). cd into a project first.${N}"
    exit 1
  fi
  set_identity
}

# $1 = untrusted|dev   $2 = client (default: this project's client)
home_volume_name() { echo "airlock-home-${2:-$AIRLOCK_CLIENT}-${1:-untrusted}"; }

# Export Claude login from the macOS Keychain into a local read-only file so the
# sandbox can reuse it. Only ever read by the container; refreshes stay inside.
# Sets CLAUDE_STATE (a colored summary) for the launch banner.
CLAUDE_STATE=""
sync_claude_creds() {
  local secrets="$DIR/.secrets" file tmp
  file="$secrets/.credentials.json"
  mkdir -p "$secrets"; chmod 700 "$secrets"
  # Write to a temp file first. `security ... > "$file"` truncated the target
  # BEFORE security ran, so a denied Keychain prompt (or a locked keychain)
  # destroyed a perfectly good cached token and left you logged out inside.
  tmp="$(mktemp "$secrets/.creds.XXXXXX")"
  if security find-generic-password -s "Claude Code-credentials" -w \
       > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$file"; chmod 600 "$file"
    CLAUDE_STATE="${G}logged in${N} ${DIM}(synced from your Keychain)${N}"
  else
    rm -f "$tmp"
    [ -f "$file" ] || : > "$file"
    chmod 600 "$file" 2>/dev/null || true
    if [ -s "$file" ]; then
      CLAUDE_STATE="${Y}cached login${N} ${DIM}(Keychain unavailable — kept last known token)${N}"
    else
      CLAUDE_STATE="${Y}not logged in${N} ${DIM}(run /login inside, or set ANTHROPIC_API_KEY)${N}"
    fi
  fi
}

# Claude login for the sandbox. Preferred: the long-lived token stored by
# `airlock login` — nothing refreshes it, so the Mac and every sandbox stop
# invalidating each other's login. Fallback: the Keychain OAuth copy above.
TOKEN_SERVICE="airlock-claude-oauth-token"
load_claude_login() {
  local tok
  if tok="$(security find-generic-password -s "$TOKEN_SERVICE" -w 2>/dev/null)" && [ -n "$tok" ]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$tok"
    # compose still mounts this path; it must stay a file, never a Docker-made dir
    mkdir -p "$DIR/.secrets"; chmod 700 "$DIR/.secrets"
    [ -f "$DIR/.secrets/.credentials.json" ] || { : > "$DIR/.secrets/.credentials.json"; chmod 600 "$DIR/.secrets/.credentials.json"; }
    CLAUDE_STATE="${G}logged in${N} ${DIM}(long-lived token from 'airlock login')${N}"
  else
    sync_claude_creds
    CLAUDE_STATE="${CLAUDE_STATE} ${DIM}· 'airlock login' stops \"Login expired\"${N}"
  fi
}

# Stage the host's global CLAUDE.md so every sandbox inherits your standing
# instructions. COPIED into .secrets/ rather than bind-mounting ~/.claude/CLAUDE.md
# directly, for two reasons:
#   1. If the host file were ever absent, Docker would create a DIRECTORY at
#      ~/.claude/CLAUDE.md — which breaks Claude Code on your Mac, not just here.
#   2. A file bind-mount nested inside the /home/node volume makes Docker
#      auto-create /home/node/.claude as root; the uid-1000 entrypoint then
#      can't write credentials into it, and there is no sudo in the image.
# Set AIRLOCK_CLAUDE_MD to another path to override, or to "" to skip entirely.
CLAUDE_MD_STATE=""
# Follow symlinks: ~/.claude/CLAUDE.md is often a link into a rules repo.
real_path() {
  realpath "$1" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null
}

# dev: mount the real global CLAUDE.md read-write (see entrypoint.sh).
link_claude_md_dev() {
  local src real lines
  src="${AIRLOCK_CLAUDE_MD-$HOME/.claude/CLAUDE.md}"
  real=""
  [ -n "$src" ] && [ -e "$src" ] && real="$(real_path "$src" || true)"
  if [ -n "$real" ] && [ -f "$real" ]; then
    export AIRLOCK_CLAUDE_MD_FILE="$real"
    lines="$(wc -l < "$real" | tr -d ' ')"
    CLAUDE_MD_STATE="${G}same file as your Mac${N} ${DIM}(${real/#$HOME/~}, ${lines} lines, read-write)${N}"
  else
    # Never let Docker invent a directory at a missing path: mount an empty stub.
    sync_claude_md
    export AIRLOCK_CLAUDE_MD_FILE="$DIR/.secrets/CLAUDE.md"
  fi
}

sync_claude_md() {
  local src dst
  src="${AIRLOCK_CLAUDE_MD-$HOME/.claude/CLAUDE.md}"
  dst="$DIR/.secrets/CLAUDE.md"
  mkdir -p "$DIR/.secrets"; chmod 700 "$DIR/.secrets"
  if [ -z "$src" ]; then
    : > "$dst"; chmod 600 "$dst"
    CLAUDE_MD_STATE="${DIM}skipped (AIRLOCK_CLAUDE_MD is empty)${N}"
  elif [ -f "$src" ]; then
    cp -L "$src" "$dst"; chmod 600 "$dst"   # -L: copy what a symlink points to
    CLAUDE_MD_STATE="${G}same as your Mac${N} ${DIM}(fresh copy, $(wc -l < "$dst" | tr -d ' ') lines, read-only inside)${N}"
  else
    : > "$dst"; chmod 600 "$dst"
    CLAUDE_MD_STATE="${Y}not found${N} ${DIM}(${src})${N}"
  fi
}

# Claude files sessions under ~/.claude/projects/<path with every
# non-alphanumeric char turned into "-">, e.g. /Users/me/Code/app ->
# -Users-me-Code-app. run mounts the project at its Mac path, so the key
# inside the sandbox is the same one your Mac's Claude uses.
claude_project_key() { printf '%s' "$1" | sed 's/[^a-zA-Z0-9]/-/g'; }

# run mode: give the sandbox THIS project's session folder from the Mac.
# AIRLOCK_RUN_HISTORY=0 keeps sessions in the client volume instead.
SESSIONS_STATE=""
prepare_run_sessions() {
  local key dir n
  if [ "${AIRLOCK_RUN_HISTORY:-1}" != 1 ]; then
    mkdir -p "$STATE_DIR/no-sessions/memory"
    export AIRLOCK_SESSIONS_DIR="$STATE_DIR/no-sessions"
    unset AIRLOCK_SESSION_KEY
    SESSIONS_STATE="${DIM}kept in the client volume (AIRLOCK_RUN_HISTORY=0)${N}"
    return 0
  fi
  key="$(claude_project_key "$WORKSPACE")"
  dir="$HOME/.claude/projects/$key"
  # Create it here, as you: if Docker had to, it would be root-owned.
  mkdir -p "$dir/memory"
  export AIRLOCK_SESSION_KEY="$key" AIRLOCK_SESSIONS_DIR="$dir"
  n="$(find "$dir" -maxdepth 1 -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ')"
  SESSIONS_STATE="${G}saved on your Mac${N} ${DIM}· ~/.claude/projects/${key} · ${n} so far · claude --resume${N}"
}

# Polished launch banner. Adapts to terminal: colored on a TTY, plain when piped.
# $1 = mode (run|dev|sbx)
launch_banner() {
  local mode="$1" wl vmode
  wl="$(readable_whitelist | wc -l | tr -d ' ')"
  if [ "$mode" = dev ]; then vmode="dev"; else vmode="untrusted"; fi
  echo ""
  hr
  if [ "$mode" = run ]; then
    echo "  🔒 ${B}${G}airlock · UNTRUSTED${N}   ${DIM}safe — locked-down sandbox${N}"
  elif [ "$mode" = sbx ]; then
    echo "  🧊 ${B}${C}airlock · SBX${N}   ${DIM}strongest — microVM (own kernel) + whitelist${N}"
  else
    echo "  ⚠  ${B}${Y}airlock · DEV${N}   ${DIM}trusted — full access, for your own code${N}"
  fi
  hr
  echo "  ${B}path${N}      ${C}${WORKSPACE}${N}"
  echo "  ${B}client${N}    ${C}${AIRLOCK_CLIENT}${N} ${DIM}· home volume $(home_volume_name "$vmode")${N}"
  if [ "$mode" = sbx ]; then
    echo "            ${DIM}↳ mounted in the microVM — the only host folder it can see${N}"
    echo "  ${B}isolation${N} ${C}microVM${N} ${DIM}· own Linux kernel — a container escape can't reach your Mac${N}"
    echo "  ${B}network${N}   ${G}whitelist only${N} ${DIM}· ${wl} domains allowed, everything else blocked${N}"
    echo "  ${B}secrets${N}   ${G}none of your files${N} ${DIM}· project dir only${N}"
    echo "  ${B}ports${N}     ${DIM}publish with: docker sandbox network proxy / ports${N}"
  else
    if [ "$mode" = run ]; then
      echo "            ${DIM}↳ mounted at the same path — the only project folder the box can see${N}"
      echo "  ${B}network${N}   ${G}whitelist only${N} ${DIM}· ${wl} domains allowed, everything else blocked${N}"
      echo "  ${B}secrets${N}   ${G}none of your files${N} ${DIM}· Claude token only${N}"
      echo "  ${B}sessions${N}  ${SESSIONS_STATE}"
    else
      echo "            ${DIM}↳ mounted at the same path inside, so Claude history matches your Mac${N}"
      echo "  ${B}network${N}   ${Y}full internet${N}"
      echo "  ${B}secrets${N}   ${Y}Claude token${N} ${DIM}· trusted mode${N}"
      echo "  ${B}history${N}   ${Y}your Mac's ~/.claude${N} ${DIM}· sessions + memory read-write, kept after exit${N}"
    fi
    if [ "$HOME_MODE" = ephemeral ]; then
      echo "  ${B}home${N}      ${Y}ephemeral${N} ${DIM}· tmpfs — logins & caches destroyed on exit${N}"
    else
      echo "  ${B}home${N}      ${G}persistent${N} ${DIM}· per-client volume — caches & logins survive${N}"
    fi
    echo "  ${B}ports${N}     ${G}1:1${N} ${DIM}$(compact_ports "$PORTS_ONE") — same URL inside and on your Mac${N}"
    if [ -n "$PORTS_MOVED" ]; then
      echo "            ${Y}↳ taken on your Mac, moved:${PORTS_MOVED} — open the new port, not the one your dev server prints${N}"
    fi
    echo "            ${DIM}↳ e.g. http://localhost:${PORTS_FIRST:-3000} · no --host needed, localhost servers are forwarded${N}"
  fi
  if [ "$mode" = run ] && [ "${AIRLOCK_NOTIFY:-1}" = 1 ]; then
    echo "  ${B}blocked${N}   ${DIM}you get a macOS notification when a site is blocked · fix: airlock allow${N}"
  fi
  [ -n "$UPDATE_STATE" ] && echo "  ${B}tools${N}     ${UPDATE_STATE}"
  if [ -s "$STATE_DIR/disk-warning" ]; then
    echo "  ${B}disk${N}      ${R}$(cat "$STATE_DIR/disk-warning")${N}"
  fi
  echo "  ${B}claude${N}    ${CLAUDE_STATE}"
  echo "  ${B}CLAUDE.md${N} ${CLAUDE_MD_STATE}"
  hr
  if [ "$mode" = sbx ]; then
    echo "  ${DIM}'exit' leaves — the microVM is KEPT (reused next spin) · new: airlock sbx --fresh · destroy: airlock sbx down${N}"
  elif [ "$HOME_MODE" = ephemeral ]; then
    echo "  ${DIM}type 'exit' to leave — container AND home are destroyed (nothing persists)${N}"
  else
    echo "  ${DIM}type 'exit' to leave — container is destroyed; this client's home volume is kept${N}"
  fi
  echo ""
}

# Find the running sandbox for THIS project (untrusted or dev), not the proxy.
running_sandbox() {
  docker ps --format '{{.ID}} {{.Names}}' \
    | grep -E " ${COMPOSE_PROJECT_NAME}-(untrusted|dev)-run" | awk '{print $1}' | head -1
}

# This project's proxy container id, if it's up.
proxy_cid() { dc --profile run ps -q proxy 2>/dev/null | head -1; }

# Proxy log: live container if running, else the saved last-session log.
proxy_log() {
  local cid; cid="$(proxy_cid || true)"
  if [ -n "${cid:-}" ]; then
    docker logs "$cid" 2>&1
  elif [ -f "$DIR/.logs/${COMPOSE_PROJECT_NAME}-proxy-last.log" ]; then
    cat "$DIR/.logs/${COMPOSE_PROJECT_NAME}-proxy-last.log"
  fi
}

# Tear down this project's proxy + networks, but ONLY if no other sandbox for
# this project is still running (so a 2nd terminal doesn't lose its network).
# Runs for dev too: dev used to leave its network behind for every project.
teardown_if_idle() {
  if docker ps --format '{{.Names}}' | grep -qE "^${COMPOSE_PROJECT_NAME}-(untrusted|dev)-run"; then
    return 0   # another sandbox is live — leave the proxy up for it
  fi
  # Persist the proxy log so `airlock blocked` still works after teardown.
  local cid; cid="$(proxy_cid || true)"
  if [ -n "${cid:-}" ]; then
    mkdir -p "$DIR/.logs"
    docker logs "$cid" > "$DIR/.logs/${COMPOSE_PROJECT_NAME}-proxy-last.log" 2>&1 || true
  fi
  echo "${DIM}› tearing down this project's network (and proxy)…${N}"
  dc --profile run --profile dev down --remove-orphans >/dev/null 2>&1 || true
}

# The sandbox container gets a known name so it can be removed on the way
# out. Closing the terminal tab (SIGHUP) used to leave it running: it kept
# its RAM, its ports (so the next project's `airlock dev` failed), and kept
# Docker's VM from ever idling.
SANDBOX_NAME=""
on_sandbox_exit() {
  stop_block_notifier
  if [ -n "$SANDBOX_NAME" ]; then
    docker rm -f "$SANDBOX_NAME" >/dev/null 2>&1 || true
  fi
  print_session_blocked || true
  teardown_if_idle
}
# $1 = untrusted|dev
arm_cleanup() {
  SANDBOX_NAME="${COMPOSE_PROJECT_NAME}-$1-run-$$"
  trap on_sandbox_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
}

# Starting the same mode twice in one project used to spin up a second 4g box
# fighting for the same ports. Attach to the live one instead.
# $1 = untrusted|dev, rest = command
attach_if_running() {
  local svc="$1" cid; shift
  cid="$(docker ps --format '{{.ID}} {{.Names}}' \
    | grep -E " ${COMPOSE_PROJECT_NAME}-${svc}-run" | awk '{print $1}' | head -1 || true)"
  [ -n "$cid" ] || return 0
  echo "› this project's ${svc} sandbox is already running — attaching to it (same as airlock exec)"
  if [ "$#" -eq 0 ]; then exec docker exec -it "$cid" "${SHELL_CMD[@]}"; else exec docker exec -it "$cid" "$@"; fi
}

# Every airlock compose project on this machine — including ones that only
# left a network behind — torn down.
down_all() {
  echo "› stopping EVERY airlock project…"
  { docker ps -a --format '{{.Label "com.docker.compose.project"}}'
    docker network ls --format '{{.Label "com.docker.compose.project"}}'; } 2>/dev/null \
    | grep '^airlock-' | sort -u | while read -r p; do
      docker compose -p "$p" "${COMPOSE_FILES[@]}" --profile run --profile dev \
        down --remove-orphans >/dev/null 2>&1 || true
    done || true   # grep finding nothing must not trip set -e/pipefail
  docker ps -aq --filter "name=^airlock-" | xargs -r docker rm -f >/dev/null 2>&1 || true
}

# Strip leading flags shared by run/dev. Sets HOME_MODE and WIPE_HOME.
WIPE_HOME=0
parse_mode_flags() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ephemeral|--throwaway) set_home_mode ephemeral; shift ;;
      --fresh)                 WIPE_HOME=1; shift ;;
      *) break ;;
    esac
  done
  PARSED_ARGS=("$@")
}

# ---- disk hygiene ------------------------------------------------------------
# Why Docker "ran out of space" after a few days across several projects:
#   * every client x mode has a home volume, and npm/pnpm/yarn caches inside
#     it only ever grow (pnpm can't hard-link across the bind mount, so its
#     store is a full extra copy of every package you ever installed);
#   * every `airlock build` left the previous image behind as a dangling
#     ~2 GB layer set, plus BuildKit cache, and nothing ever pruned them;
#   * volumes of clients you stopped working on were kept forever;
#   * container logs were unbounded (now capped in docker-compose.yml).
# `airlock clean` fixes all of that, and runs itself (light mode) at most
# once a day in the background on launch.

CACHE_LIMIT_GB="${AIRLOCK_CACHE_LIMIT_GB:-3}"   # per home volume, before auto-trim
STALE_DAYS="${AIRLOCK_STALE_DAYS:-30}"          # a volume unused this long is "stale"
DISK_WARN_PCT="${AIRLOCK_DISK_WARN_PCT:-75}"

mark_volume_used() {  # $1 = volume name
  mkdir -p "$STATE_DIR/used"; : > "$STATE_DIR/used/$1"
}
# Days since a volume was last launched; empty if never tracked.
volume_idle_days() {
  local f="$STATE_DIR/used/$1"
  [ -f "$f" ] || return 0
  echo $(( ( $(date +%s) - $(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f") ) / 86400 ))
}
volume_in_use() { [ -n "$(docker ps -q --filter "volume=$1" 2>/dev/null)" ]; }

# Docker Desktop's whole VM disk. Docker.raw is a sparse file: its apparent
# size is the configured limit, its allocated size is what's really used.
vm_disk_pct() {
  local raw="$HOME/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw" used lim
  [ -f "$raw" ] || return 0
  used=$(du -k "$raw" | cut -f1)
  lim=$(( $(stat -f %z "$raw") / 1024 ))
  [ "$lim" -gt 0 ] && echo $(( used * 100 / lim ))
}
human_kb() { awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k/1048576; else printf "%d MB", k/1024 }'; }

# Runs inside a throwaway, network-less container with one home volume
# mounted. Prints "cache_kb_before cache_kb_after home_kb". Only package
# manager caches are touched — logins, nvm versions and Claude history stay.
TRIM_SH='
caches="$HOME/.npm/_cacache $HOME/.npm/_npx $HOME/.local/share/pnpm/store $HOME/.cache/pnpm $HOME/.cache/yarn $HOME/.yarn/berry/cache $HOME/.bun/install/cache $HOME/.cache/node-gyp"
cache_kb() { du -sk $caches 2>/dev/null | awk "{s+=\$1} END {print s+0}"; }
before=$(cache_kb)
if [ "$before" -ge "$LIMIT_KB" ]; then rm -rf $caches; fi
echo "$before $(cache_kb) $(du -sk "$HOME" 2>/dev/null | cut -f1)"
'
# $1 = volume, $2 = limit in KB (0 = always trim)
trim_volume() {
  docker run --rm --network none --cap-drop ALL --security-opt no-new-privileges:true \
    --user 1000:1000 -e HOME=/home/node -e LIMIT_KB="$2" \
    -v "$1:/home/node" --entrypoint sh "$SANDBOX_IMAGE" -c "$TRIM_SH" 2>/dev/null
}

# $1 = --auto (light, background, never deletes volumes)
#      --stale (also delete home volumes unused for STALE_DAYS)
#      --deep  (also drop ALL build cache; next build is slow)
#      ""      (normal: trim every idle volume's caches)
airlock_clean() {
  local how="${1:-}" v kb before after home freed=0 stale_list="" stale_kb=0 idle pct
  local quiet=0; [ "$how" = --auto ] && quiet=1
  say() { [ "$quiet" = 1 ] || echo "$@"; }

  # Leftovers from closed laptops / crashed terminals (the exit trap never
  # ran). Networks cost no disk, but Docker only has ~30 address pools: enough
  # orphans and every new project fails with "could not find an available,
  # non-overlapping IPv4 address pool".
  # --auto runs while a sandbox is starting, so it skips that project and
  # never touches "created" containers (that's what a starting one is).
  local skip="${AIRLOCK_SKIP_PROJECT:-^$}" states="--filter status=exited --filter status=dead"
  [ "$quiet" = 1 ] || states="$states --filter status=created"
  say "› removing leftover airlock containers and networks…"
  # shellcheck disable=SC2086
  docker ps -a $states --format '{{.ID}} {{.Names}}' --filter "name=^airlock-" 2>/dev/null \
    | grep -vE " ${skip}-" | awk '{print $1}' | xargs -r docker rm -f >/dev/null 2>&1 || true
  docker network ls --format '{{.Name}}' 2>/dev/null | grep '^airlock-' | grep -vE "^${skip}_" \
    | xargs -r -n1 docker network rm >/dev/null 2>&1 || true   # in-use ones refuse; fine

  say "› removing dangling images (old builds) and build cache…"
  docker image prune -f >/dev/null 2>&1 || true
  if [ "$how" = --deep ]; then
    docker builder prune -af >/dev/null 2>&1 || true
  else
    docker builder prune -f --filter until=168h >/dev/null 2>&1 || true
  fi

  if image_exists "$SANDBOX_IMAGE"; then
    say "› trimming package caches in home volumes…"
    for v in $(docker volume ls -q 2>/dev/null | grep '^airlock-home-' || true); do
      if volume_in_use "$v"; then say "    ${DIM}skip $v (in use)${N}"; continue; fi
      # never tracked (older airlock) -> start tracking from today
      [ -f "$STATE_DIR/used/$v" ] || mark_volume_used "$v"
      idle="$(volume_idle_days "$v")"
      # auto mode runs while a sandbox may be starting: leave fresh ones alone
      if [ "$quiet" = 1 ] && [ -n "$(find "$STATE_DIR/used/$v" -mmin -30 2>/dev/null)" ]; then continue; fi
      if [ "$how" = --stale ] && [ "${idle:-0}" -ge "$STALE_DAYS" ]; then
        docker volume rm "$v" >/dev/null 2>&1 && { rm -f "$STATE_DIR/used/$v"; say "    ${Y}removed${N} $v ${DIM}(unused ${idle} days)${N}"; }
        continue
      fi
      if [ "$quiet" = 1 ]; then kb=$(( CACHE_LIMIT_GB * 1048576 )); else kb=0; fi
      read -r before after home <<<"$(trim_volume "$v" "$kb" || echo "0 0 0")"
      freed=$(( freed + ${before:-0} - ${after:-0} ))
      [ "${before:-0}" -gt "${after:-0}" ] && say "    $v  ${G}-$(human_kb $(( before - after )))${N} ${DIM}(now $(human_kb "${home:-0}"))${N}"
      if [ "${idle:-0}" -ge "$STALE_DAYS" ]; then
        stale_list="$stale_list $v"; stale_kb=$(( stale_kb + ${home:-0} ))
      fi
    done
  fi
  say "› freed about $(human_kb "$freed") of package caches"

  # Banner warning for the next launch (empty file = all good).
  mkdir -p "$STATE_DIR"; : > "$STATE_DIR/disk-warning"
  pct="$(vm_disk_pct || true)"
  if [ -n "$pct" ] && [ "$pct" -ge "$DISK_WARN_PCT" ]; then
    echo "Docker disk ${pct}% full — run: airlock clean --stale (or --deep)" > "$STATE_DIR/disk-warning"
  elif [ -n "$stale_list" ]; then
    echo "$(echo $stale_list | wc -w | tr -d ' ') client volume(s) unused >${STALE_DAYS}d hold $(human_kb "$stale_kb") — airlock clean --stale" > "$STATE_DIR/disk-warning"
  fi
  [ -n "$stale_list" ] && [ "$how" != --stale ] && say "› unused >${STALE_DAYS} days:${stale_list} — delete with: airlock clean --stale"
  [ -n "$pct" ] && say "› Docker disk is ${pct}% full"
  date +%s > "$STATE_DIR/last-clean"
}

# Once a day, on launch, in the background — so nobody has to remember.
maybe_auto_clean() {
  [ "${AIRLOCK_AUTO_CLEAN:-1}" = 1 ] || return 0
  local last=0
  [ -f "$STATE_DIR/last-clean" ] && last="$(cat "$STATE_DIR/last-clean" 2>/dev/null || echo 0)"
  [ $(( $(date +%s) - ${last:-0} )) -ge 86400 ] || return 0
  mkdir -p "$STATE_DIR" "$DIR/.logs"
  date +%s > "$STATE_DIR/last-clean"   # claim the slot before forking
  AIRLOCK_SKIP_PROJECT="$COMPOSE_PROJECT_NAME" \
    nohup "$DIR/airlock" clean --auto > "$DIR/.logs/clean-last.log" 2>&1 < /dev/null &
  disown 2>/dev/null || true
}

# ---- keeping the tools current -------------------------------------------------
# The image installs the latest of everything, but Docker's layer cache froze
# it at the first build. `airlock update` rebuilds with --pull and a new
# AIRLOCK_REFRESH (see Dockerfile); this runs it in the background every
# AIRLOCK_UPDATE_DAYS so the sandbox is never more than a few days behind.
UPDATE_DAYS="${AIRLOCK_UPDATE_DAYS:-3}"
days_since() {  # $1 = file holding an epoch; empty if missing
  [ -s "$1" ] || return 0
  echo $(( ( $(date +%s) - $(cat "$1" 2>/dev/null || echo 0) ) / 86400 ))
}
UPDATE_STATE=""
maybe_auto_update() {
  local age tried
  [ "${AIRLOCK_AUTO_UPDATE:-1}" = 1 ] || return 0
  [ -d "$STATE_DIR/update.lock" ] && { UPDATE_STATE="${DIM}updating in the background — next launch gets it${N}"; return 0; }
  age="$(days_since "$STATE_DIR/last-update")"
  [ -n "$age" ] && [ "$age" -lt "$UPDATE_DAYS" ] && return 0
  # Offline or failing: retry at most every 6 hours, not on every launch.
  tried="$(find "$STATE_DIR/last-update-try" -mmin -360 2>/dev/null || true)"
  [ -z "$tried" ] || return 0
  mkdir -p "$STATE_DIR" "$DIR/.logs"; : > "$STATE_DIR/last-update-try"
  nohup "$DIR/airlock" update --auto > "$DIR/.logs/update-last.log" 2>&1 < /dev/null &
  disown 2>/dev/null || true
  UPDATE_STATE="${DIM}updating Node/Claude/CLIs to latest in the background — next launch gets it${N}"
}
image_versions() {
  docker run --rm --network none --entrypoint cat "$SANDBOX_IMAGE" /opt/airlock-versions.txt 2>/dev/null || true
}

# ---- blocked-site feedback ----------------------------------------------------
# "The website doesn't load" in run mode was almost always the whitelist, but
# nothing said so. Now: a macOS notification the first time each host is
# blocked, and a summary with the exact `airlock allow` line on exit.
blocked_hosts() {  # stdin: proxy log -> unique blocked hosts, minus ones allowed since
  sed -nE 's/.*refused on filtered domain "([^"]+)".*/\1/p' | tr -cd 'A-Za-z0-9.\n-' | sort -u \
    | grep -viEf <(grep -vE '^[[:space:]]*(#|$)' "$FILTER") || true
}
SESSION_START=""
NOTIFIER_PID=""
start_block_notifier() {
  SESSION_START="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  [ "${AIRLOCK_NOTIFY:-1}" = 1 ] && command -v osascript >/dev/null 2>&1 || return 0
  local seen; seen="$(mktemp)"
  (
    set +e +o pipefail   # a dropped log stream must not kill the watcher
    since="$SESSION_START"
    while :; do
      cid="$(proxy_cid 2>/dev/null || true)"
      if [ -n "$cid" ]; then
        docker logs -f --since "$since" "$cid" 2>&1 | while IFS= read -r line; do
          host="$(printf '%s\n' "$line" | blocked_hosts)"
          [ -n "$host" ] && ! grep -qxF "$host" "$seen" || continue
          echo "$host" >> "$seen"
          osascript -e "display notification \"Run on your Mac: airlock allow $host\" with title \"airlock blocked $host\" subtitle \"Not on the whitelist (${COMPOSE_PROJECT_NAME#airlock-})\"" >/dev/null 2>&1 || true
        done
        since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"   # proxy restarted (airlock allow)
      fi
      sleep 2
    done
  ) >/dev/null 2>&1 &
  NOTIFIER_PID=$!
}
stop_block_notifier() {
  [ -n "$NOTIFIER_PID" ] || return 0
  local kids; kids="$(pgrep -P "$NOTIFIER_PID" 2>/dev/null || true)"
  kill "$NOTIFIER_PID" 2>/dev/null || true
  [ -n "$kids" ] && kill $kids 2>/dev/null || true
  NOTIFIER_PID=""
}
print_session_blocked() {
  [ -n "$SESSION_START" ] || return 0
  local cid hosts; cid="$(proxy_cid || true)"
  [ -n "${cid:-}" ] || return 0
  hosts="$(docker logs --since "$SESSION_START" "$cid" 2>&1 | blocked_hosts)"
  [ -n "$hosts" ] || return 0
  echo ""
  echo "  ${Y}⚠ the whitelist blocked these sites this session:${N}"
  printf '%s\n' "$hosts" | sed "s/^/    ${R}✗${N} /"
  echo "  ${DIM}allow the ones you trust:${N} airlock allow   ${DIM}(pick from a list)${N}"
}

# "https://API.Sanity.io:443/v1/x" -> "api.sanity.io". The proxy matches the
# HOST only, so a port/scheme/path in a rule silently never matched.
normalize_domain() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed -E 's#^[a-z]+://##; s#[/?#].*$##; s#:[0-9]+$##; s#^\*\.##; s#\.$##'
}
allow_domain() {
  local dom esc
  dom="$(normalize_domain "$1")"
  if ! printf '%s' "$dom" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'; then
    echo "${R}✗ '$1' isn't a domain${N} ${DIM}(e.g. api.example.com)${N}"; return 1
  fi
  esc="$(printf '%s' "$dom" | sed 's/\./\\./g')"
  # Two rules, not one. A lone '\.example\.com$' matches www.example.com but
  # NOT example.com itself — the bare-domain anchor is required as well.
  if grep -qxF "^${esc}\$" "$FILTER" 2>/dev/null; then
    echo "› '$dom' is already on the whitelist"
  else
    printf '^%s$\n' "$esc" >> "$FILTER"
    printf '\\.%s$\n' "$esc" >> "$FILTER"
    echo "› added ${C}${dom}${N} and ${C}*.${dom}${N} to the whitelist"
  fi
}

# ---- habit guard (host shell) -------------------------------------------------
GUARD_RCS=("$HOME/.zshrc" "$HOME/.bashrc")
guard_line() { printf 'AIRLOCK_BIN="%s/airlock"; [ -f "%s/shell/guard.sh" ] && . "%s/shell/guard.sh"  # airlock guard\n' "$DIR" "$DIR" "$DIR"; }

# ---- sbx (Docker microVM) integration -------------------------------------
# NOTE: `docker sandbox` has been REMOVED from current Docker Desktop. This
# path exits with guidance rather than failing obscurely.
SBX_TEMPLATE="${AIRLOCK_SBX_TEMPLATE-$SANDBOX_IMAGE}"

dsbx() { docker sandbox "$@"; }

sbx_require() {
  if ! docker sandbox version >/dev/null 2>&1; then
    echo "${R}✗ 'docker sandbox' is not available on this Docker.${N}"
    echo "  It was removed from Docker Desktop (see: Docker Sandboxes)."
    echo "  Use ${G}airlock run${N} (container mode) instead."
    exit 1
  fi
}

sbx_name() {
  local base hash
  base="$(basename "$WORKSPACE" | tr -cs 'A-Za-z0-9._+-' '-' | sed 's/-*$//')"
  hash="$(printf '%s' "$WORKSPACE" | cksum | cut -d' ' -f1)"
  printf 'airlock-%s-%s' "${base:-ws}" "$hash"
}

sbx_exists() { docker sandbox ls 2>/dev/null | grep -qw "$1"; }

sbx_apply_whitelist() {
  local name="$1" d; local -a allow=()
  while IFS= read -r d; do
    [ -n "$d" ] && allow+=(--allow-host "$d")
  done < <(readable_whitelist | sed -E 's/^\*\.//' | sort -u)
  dsbx network proxy "$name" --policy deny "${allow[@]}" >/dev/null
}

