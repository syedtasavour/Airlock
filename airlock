cmd="${1:-help}"; shift || true

case "$cmd" in
  run|shell)
    parse_mode_flags "$@"; set -- "${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}"
    set_workspace
    ensure_docker
    attach_if_running untrusted "$@"
    if [ "$WIPE_HOME" = 1 ] && [ "$HOME_MODE" = persistent ]; then
      echo "${DIM}› --fresh: removing home volume $(home_volume_name untrusted)…${N}"
      docker volume rm "$(home_volume_name untrusted)" >/dev/null 2>&1 || true
    fi
    ensure_built run
    plan_ports untrusted
    load_claude_login
    sync_claude_md
    prepare_run_sessions
    [ "$HOME_MODE" = persistent ] && mark_volume_used "$(home_volume_name untrusted)"
    maybe_auto_clean
    maybe_auto_update
    launch_banner run
    # When this sandbox shell exits — or the terminal is closed — remove the
    # container and stop the proxy too, unless another sandbox terminal for
    # this project is still running.
    arm_cleanup untrusted
    start_block_notifier
    if [ "$#" -eq 0 ]; then
      dc --profile run run --rm --service-ports --name "$SANDBOX_NAME" untrusted "${SHELL_CMD[@]}"
    else
      dc --profile run run --rm --service-ports --name "$SANDBOX_NAME" untrusted "$@"
    fi
    ;;

  dev)
    parse_mode_flags "$@"; set -- "${PARSED_ARGS[@]+"${PARSED_ARGS[@]}"}"
    set_workspace
    ensure_docker
    attach_if_running dev "$@"
    if [ "$WIPE_HOME" = 1 ] && [ "$HOME_MODE" = persistent ]; then
      echo "${DIM}› --fresh: removing home volume $(home_volume_name dev)…${N}"
      docker volume rm "$(home_volume_name dev)" >/dev/null 2>&1 || true
    fi
    ensure_built dev
    plan_ports dev
    load_claude_login
    # dev mounts ~/.claude itself; create it so Docker never has to.
    mkdir -p "$HOME/.claude"
    link_claude_md_dev
    [ "$HOME_MODE" = persistent ] && mark_volume_used "$(home_volume_name dev)"
    maybe_auto_clean
    maybe_auto_update
    launch_banner dev
    arm_cleanup dev
    if [ "$#" -eq 0 ]; then
      dc --profile dev run --rm --service-ports --name "$SANDBOX_NAME" dev "${SHELL_CMD[@]}"
    else
      dc --profile dev run --rm --service-ports --name "$SANDBOX_NAME" dev "$@"
    fi
    ;;

  exec)
    set_identity
    cid="$(running_sandbox || true)"
    if [ -z "${cid:-}" ]; then
      echo "✗ no running sandbox for this project — start one first: airlock run"
      exit 1
    fi
    echo "› attaching to running sandbox $cid"
    if [ "$#" -eq 0 ]; then docker exec -it "$cid" "${SHELL_CMD[@]}"; else docker exec -it "$cid" "$@"; fi
    ;;

  reset)
    set_identity
    ensure_docker
    client="$(slugify "${1:-$AIRLOCK_CLIENT}")"
    gone=0
    for m in untrusted dev; do
      vol="$(home_volume_name "$m" "$client")"
      if docker volume inspect "$vol" >/dev/null 2>&1; then
        echo "› removing ${C}${vol}${N} ${DIM}(caches, logins, Claude history)${N}"
        docker volume rm "$vol" >/dev/null && gone=$(( gone + 1 ))
      fi
    done
    [ "$gone" = 0 ] && echo "› no home volumes for client '${client}' — nothing to reset" || echo "› done ($gone removed)"
    ;;

  sbx)
    sbx_require
    set_workspace
    name="$(sbx_name)"
    case "${1:-}" in
      down|rm)
        if sbx_exists "$name"; then
          echo "› removing microVM sandbox '$name'…"
          dsbx rm "$name" >/dev/null 2>&1 || true
          echo "› done"
        else
          echo "› no microVM for this project — nothing to remove"
        fi
        exit 0
        ;;
      --fresh|fresh|new)
        shift || true
        if sbx_exists "$name"; then
          echo "${DIM}› --fresh: deleting old microVM '$name'…${N}"
          dsbx rm "$name" >/dev/null 2>&1 || true
        fi
        ;;
    esac
    if sbx_exists "$name"; then
      echo "${DIM}› reusing microVM '$name' — login + installs from last time persist${N}"
    else
      ensure_built dev
      echo "${DIM}› creating microVM sandbox '$name'…${N}"
      if [ -n "$SBX_TEMPLATE" ]; then
        dsbx create --name "$name" --template "$SBX_TEMPLATE" shell "$WORKSPACE"
      else
        dsbx create --name "$name" shell "$WORKSPACE"
      fi
    fi
    echo "${DIM}› applying egress whitelist (default-deny)…${N}"
    sbx_apply_whitelist "$name"
    CLAUDE_STATE="${DIM}run /login once — it persists (sandbox is kept)${N}"
    launch_banner sbx
    if [ "$#" -eq 0 ]; then
      dsbx run "$name"
    elif [ -t 0 ]; then
      dsbx exec -it "$name" "$@"
    else
      dsbx exec -i "$name" "$@"
    fi
    ;;

  allow)
    set_identity
    if [ "$#" -eq 0 ]; then
      # No domain given: pick from what this project's proxy actually blocked.
      picks=()
      while IFS= read -r h; do [ -n "$h" ] && picks+=("$h"); done \
        < <(proxy_log | blocked_hosts)
      if [ "${#picks[@]}" -eq 0 ]; then
        echo "› nothing blocked for this project yet."
        echo "  usage: airlock allow <domain> [more…]   e.g. airlock allow api.example.com"
        exit 0
      fi
      echo "  ${B}Blocked for ${COMPOSE_PROJECT_NAME#airlock-}:${N}"
      for i in "${!picks[@]}"; do printf "    %2d) %s\n" "$(( i + 1 ))" "${picks[$i]}"; done
      printf "  allow which? ${DIM}(numbers, e.g. 1 3 — 'a' for all, Enter to cancel)${N} "
      read -r ans || ans=""
      sel=()
      if [ "$ans" = a ]; then sel=("${picks[@]}")
      else for n in $ans; do
        [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "${#picks[@]}" ] && sel+=("${picks[$(( n - 1 ))]}")
      done; fi
      [ "${#sel[@]}" -gt 0 ] || { echo "› nothing changed"; exit 0; }
      set -- "${sel[@]}"
    fi
    for dom in "$@"; do allow_domain "$dom" || true; done
    # The filter is bind-mounted now, so a proxy restart is enough — no rebuild.
    cid="$(proxy_cid || true)"
    if [ -n "${cid:-}" ]; then
      docker restart "$cid" >/dev/null && echo "› proxy reloaded — active now"
    else
      echo "› takes effect on the next 'airlock run' (no rebuild needed)"
    fi
    ;;

  down)
    set_identity
    docker_running || { echo "› Docker isn't running — nothing to stop"; exit 0; }
    if [ "${1:-}" = "--all" ]; then
      down_all
    else
      echo "› stopping sandbox + proxy for ${C}${COMPOSE_PROJECT_NAME}${N}…"
      dc --profile run --profile dev down --remove-orphans >/dev/null 2>&1 || true
      docker ps -a --format '{{.ID}} {{.Names}}' \
        | grep -E " ${COMPOSE_PROJECT_NAME}-(untrusted|dev)-run" | awk '{print $1}' \
        | xargs -r docker rm -f >/dev/null 2>&1 || true
    fi
    echo "${DIM}› home volumes are kept — wipe one with: airlock reset [client]${N}"
    echo "› done"
    ;;

  reboot|restart)
    # Like shutting a PC down and starting it again: every airlock sandbox and
    # proxy stops, their containers and networks go, Docker's VM restarts
    # (memory and engine state cleared), and it waits until Docker is back.
    # Kept, like a disk across a reboot: home volumes (logins, caches,
    # history), images, the whitelist. `airlock reboot run|dev` then starts
    # this project's sandbox fresh.
    set_identity
    yes=0
    case "${1:-}" in -y|--yes) yes=1; shift ;; esac
    t0=$(date +%s)
    if docker_running; then
      live="$(docker ps --format '{{.Names}}' --filter "name=^airlock-" 2>/dev/null | grep -E -- '-(untrusted|dev)-run' || true)"
      if [ -n "$live" ] && [ "$yes" = 0 ] && [ -t 0 ]; then
        echo "  ${Y}these sandboxes are open — their terminals will be closed:${N}"
        printf '%s\n' "$live" | sed 's/^/    • /'
        printf "  reboot anyway? [y/N] "; read -r ans || ans=""
        case "$ans" in y|Y|yes) ;; *) echo "› cancelled"; exit 0 ;; esac
      fi
      echo "› stopping every airlock sandbox and proxy…"
      down_all
      echo "› restarting Docker (clears its VM memory and engine state)…"
      if ! docker desktop restart >/dev/null 2>&1; then
        docker desktop stop >/dev/null 2>&1 || osascript -e 'quit app "Docker"' >/dev/null 2>&1 || true
      fi
      # Make sure the OLD engine is really gone before waiting for the new one.
      for i in $(seq 1 30); do docker_running || break; sleep 1; done
    else
      echo "› Docker was stopped — starting it fresh…"
    fi
    ensure_docker
    # Anything that survived (crashed containers, orphaned networks).
    docker ps -aq --filter "name=^airlock-" | xargs -r docker rm -f >/dev/null 2>&1 || true
    docker network ls --format '{{.Name}}' | grep '^airlock-' | xargs -r -n1 docker network rm >/dev/null 2>&1 || true
    echo "› ${G}rebooted${N} in $(( $(date +%s) - t0 ))s — Docker is fresh, no airlock containers running."
    echo "  ${DIM}kept: home volumes (logins, caches, history), images, whitelist${N}"
    case "${1:-}" in
      run|dev) echo "› starting this project's $1 sandbox…"; exec "$DIR/airlock" "$@" ;;
      "") echo "  start again with: airlock run   (or: airlock dev)" ;;
    esac
    ;;

  off)
    set_identity
    if docker_running; then
      down_all
      echo "› quitting Docker Desktop — its VM memory goes back to macOS…"
      docker desktop stop >/dev/null 2>&1 || osascript -e 'quit app "Docker"' >/dev/null 2>&1 || true
    else
      echo "› Docker is already stopped"
    fi
    echo "› done — 'airlock run' / 'airlock dev' start Docker again automatically"
    ;;

  login)
    echo "› step 1: create a long-lived Claude token (opens your browser)"
    if command -v claude >/dev/null 2>&1; then
      claude setup-token || true
    else
      echo "  run on your Mac: claude setup-token"
    fi
    echo ""
    echo "› step 2: paste that token below (input is hidden, asked twice)."
    echo "  ${DIM}Saved to your macOS Keychain as '${TOKEN_SERVICE}' — never to a file.${N}"
    # -w as the LAST option makes `security` prompt, so the token never
    # appears in argv / the process list.
    security add-generic-password -U -a "$USER" -s "$TOKEN_SERVICE" -l "airlock Claude token" -w
    echo "› saved — every new sandbox uses it; no more \"Login expired\""
    ;;

  logout)
    if security delete-generic-password -s "$TOKEN_SERVICE" >/dev/null 2>&1; then
      echo "› removed — sandboxes fall back to your Keychain Claude login"
    else
      echo "› no airlock token stored — nothing to remove"
    fi
    ;;

  status)
    set_identity
    if ! docker_running; then
      echo "  ${B}airlock — status${N}  ${DIM}Docker is stopped — using no RAM. 'airlock run' / 'dev' start it.${N}"
      exit 0
    fi
    echo ""
    hr; echo "  ${B}airlock — status${N}"; hr
    echo ""
    echo "  ${B}This project${N}"
    echo "    path      ${C}${WORKSPACE}${N}"
    echo "    client    ${C}${AIRLOCK_CLIENT}${N}   ${DIM}compose project ${COMPOSE_PROJECT_NAME}${N}"
    echo "    ports     ${DIM}$(compact_ports "$(wanted_ports)") — 1:1 when free, busy ones move to 1<port>${N}"
    echo ""

    echo "  ${B}Images${N}"
    if image_exists "$SANDBOX_IMAGE"; then echo "    ${G}✓${N} sandbox   ${DIM}${SANDBOX_IMAGE}${N}"
    else echo "    ${R}✗${N} sandbox   ${DIM}${SANDBOX_IMAGE}${N}   ${Y}→ run: airlock build${N}"; fi
    if image_exists "$PROXY_IMAGE"; then echo "    ${G}✓${N} proxy     ${DIM}${PROXY_IMAGE}${N}"
    else echo "    ${R}✗${N} proxy     ${DIM}${PROXY_IMAGE}${N}   ${Y}→ run: airlock build${N}"; fi
    age="$(days_since "$STATE_DIR/last-update")"
    if [ -z "$age" ]; then echo "    ${Y}tools never updated by airlock${N} ${DIM}→ airlock update${N}"
    else echo "    ${DIM}tools updated ${age} day(s) ago · auto every ${UPDATE_DAYS} days · now: airlock update${N}"; fi
    image_exists "$SANDBOX_IMAGE" && image_versions | awk '{printf "      %-9s %s\n", $1, substr($0, length($1)+2)}' | sed "s/^/${DIM}/; s/\$/${N}/"
    echo ""

    echo "  ${B}Client home volumes${N}"
    vols="$(docker volume ls --format '{{.Name}}' 2>/dev/null | grep '^airlock-home-' || true)"
    if [ -z "$vols" ]; then
      echo "    ${DIM}none yet — created on first run${N}"
    else
      printf '%s\n' "$vols" | while read -r v; do
        mark=" "
        case "$v" in "$(home_volume_name untrusted)"|"$(home_volume_name dev)") mark="${G}•${N}" ;; esac
        echo "    ${mark} ${C}${v#airlock-home-}${N}  ${DIM}${v}${N}"
      done
    fi
    echo ""

    echo "  ${B}Running now${N}"
    found=0
    stats="$(docker stats --no-stream --format '{{.Name}}	{{.MemUsage}}' 2>/dev/null || true)"
    while IFS=$'\t' read -r name st; do
      [ -z "$name" ] && continue
      found=1
      mem="$(printf '%s\n' "$stats" | awk -F'\t' -v n="$name" '$1==n {split($2, a, " / "); print a[1]}')"
      [ -n "$mem" ] && st="$st · ${mem} RAM"
      case "$name" in
        *untrusted*) echo "    🔒 ${G}SAFE${N}     ${name}  ${DIM}· untrusted · whitelist net · ${st}${N}" ;;
        *dev*)       echo "    ⚠  ${Y}TRUSTED${N}  ${name}  ${DIM}· full internet · ${st}${N}" ;;
        *proxy*)     echo "    🛡  ${C}proxy${N}    ${name}  ${DIM}· egress whitelist · ${st}${N}" ;;
        *)           echo "    • ${name}  ${DIM}· ${st}${N}" ;;
      esac
    done < <(docker ps --filter "name=airlock" --format '{{.Names}}\t{{.Status}}')
    [ "$found" = 0 ] && echo "    ${DIM}nothing running — sandboxes are disposable, this is normal${N}"
    vm_gib="$(docker info --format '{{.MemTotal}}' 2>/dev/null | awk '{printf "%.1f", $1/1073741824}')"
    echo "    ${DIM}Docker VM holds ${vm_gib} GiB while Docker runs · give it back: airlock off${N}"
    echo ""

    wl_count="$(readable_whitelist | wc -l | tr -d ' ')"
    echo "  ${B}Network whitelist${N}  ${DIM}· ${wl_count} rules reachable in 'run' mode; all others blocked${N}"
    printf '%s' "$C"
    readable_whitelist | awk '{printf "    %-26s", $0; if (NR%2==0) printf "\n"} END {if (NR%2) printf "\n"}'
    printf '%s' "$N"
    echo "    ${DIM}edit: airlock allow <domain>   ·   list lives in proxy/filter${N}"
    hr
    ;;

  blocked)
    set_identity
    if [ -n "$(proxy_cid || true)" ]; then src="live"; else src="last session"; fi
    echo ""
    hr; echo "  ${B}airlock — blocked egress${N}  ${DIM}· ${src} · ${COMPOSE_PROJECT_NAME}${N}"; hr
    blk="$(proxy_log | sed -nE 's/.*Proxying refused on filtered domain "([^"]+)".*/\1/p' | sort | uniq -c | sort -rn)"
    if [ -z "$blk" ]; then
      echo "    ${G}nothing blocked${N} ${DIM}— no denied requests recorded${N}"
    else
      echo "  ${B}Denied — not on the whitelist:${N}"
      printf '%s\n' "$blk" | while read -r n host; do
        printf "    ${R}✗${N} ${C}https://%s${N}%*s${DIM}%s×${N}\n" "$host" $(( 34 - ${#host} > 1 ? 34 - ${#host} : 1 )) "" "$n"
      done
      echo ""
      echo "    ${DIM}to permit one:${N} airlock allow <domain>   ${DIM}(instant — no rebuild)${N}"
    fi
    hr
    ;;

  # Each build re-tags :latest and leaves the old ~2 GB image dangling.
  build)   set_identity; ensure_docker; dc --profile run --profile dev build "$@"
           docker image prune -f >/dev/null 2>&1 || true ;;
  rebuild) set_identity; ensure_docker; dc --profile run --profile dev build --no-cache "$@"
           docker image prune -f >/dev/null 2>&1 || true ;;

  update)
    set_identity; ensure_docker
    mkdir -p "$STATE_DIR"
    # One at a time: a manual update while the background one runs would
    # just do the same multi-minute build twice.
    if ! mkdir "$STATE_DIR/update.lock" 2>/dev/null; then
      echo "› an update is already running — see .logs/update-last.log"; exit 0
    fi
    trap 'rmdir "$STATE_DIR/update.lock" 2>/dev/null || true' EXIT
    echo "› updating to the latest: Node ${AIRLOCK_NODE_VERSION:-LTS} base + OS packages, npm, pnpm, nvm,"
    echo "  Claude Code, vercel, netlify, heroku, firebase, wrangler, tinyproxy…"
    echo "  ${DIM}(a few minutes; running sandboxes keep their version until you restart them)${N}"
    if dc --profile run --profile dev build --pull --build-arg AIRLOCK_REFRESH="$(date +%s)"; then
      date +%s > "$STATE_DIR/last-update"
      docker image prune -f >/dev/null 2>&1 || true   # the version it replaced
      echo "› up to date:"
      image_versions | sed 's/^/    /'
      [ "${1:-}" = --auto ] && command -v osascript >/dev/null 2>&1 \
        && osascript -e 'display notification "Node, Claude Code and the deploy CLIs are on their latest versions." with title "airlock updated"' >/dev/null 2>&1 || true
    else
      echo "${R}✗ update failed — your current image is untouched.${N} Retry: airlock update"
      exit 1
    fi
    ;;

  clean)
    docker_running || { echo "› Docker isn't running — nothing to clean"; exit 0; }
    case "${1:-}" in
      ""|--auto|--stale|--deep) airlock_clean "${1:-}" ;;
      *) echo "usage: airlock clean [--stale | --deep]"; exit 1 ;;
    esac
    [ "${1:-}" = --auto ] || echo "› done — see what's left: airlock disk"
    ;;

  disk|df)
    ensure_docker
    echo ""
    hr; echo "  ${B}airlock — disk${N}"; hr
    pct="$(vm_disk_pct || true)"
    if [ -n "$pct" ]; then
      [ "$pct" -ge "$DISK_WARN_PCT" ] && col="$R" || col="$G"
      echo "  Docker's VM disk is ${col}${pct}% full${N}"
    fi
    echo ""
    docker system df 2>/dev/null | sed 's/^/  /'
    echo ""
    echo "  ${B}Client home volumes${N}  ${DIM}(caches, logins, Claude history)${N}"
    docker system df -v 2>/dev/null | awk '/^airlock-home-/ {print $1, $NF}' \
      | while read -r v size; do
          idle="$(volume_idle_days "$v")"
          if volume_in_use "$v"; then age="${G}in use${N}"
          elif [ -z "$idle" ]; then age="${DIM}not tracked yet${N}"
          elif [ "$idle" -ge "$STALE_DAYS" ]; then age="${Y}unused ${idle}d${N}"
          else age="${DIM}used ${idle}d ago${N}"; fi
          printf "    %-44s %9s   %s\n" "$v" "$size" "$age"
        done
    echo ""
    echo "  ${DIM}free space:${N}  airlock clean          ${DIM}leftovers + old builds + package caches${N}"
    echo "               airlock clean --stale  ${DIM}…and delete volumes unused >${STALE_DAYS} days${N}"
    echo "               airlock clean --deep   ${DIM}…and ALL build cache (next build is slow)${N}"
    echo "               airlock reset <client> ${DIM}delete one client's volumes${N}"
    hr
    ;;

  guard)
    case "${1:-status}" in
      on|install)
        chmod +x "$DIR/shell/guard.sh" 2>/dev/null || true
        for rc in "${GUARD_RCS[@]}"; do
          [ -e "$rc" ] || continue
          if grep -q '# airlock guard$' "$rc"; then echo "✓ already on in $rc"
          else printf '\n%s\n' "$(guard_line)" >> "$rc"; echo "✓ guard added to $rc"; fi
        done
        echo "› open a new terminal (or: source ~/.zshrc). Typing npm/pnpm/yarn/npx/bun/node"
        echo "  inside a project on your Mac now asks to run it in airlock instead."
        ;;
      off|uninstall)
        for rc in "${GUARD_RCS[@]}"; do
          [ -e "$rc" ] && grep -q '# airlock guard$' "$rc" || continue
          tmp="$(mktemp)"; grep -v '# airlock guard$' "$rc" > "$tmp" && cat "$tmp" > "$rc"; rm -f "$tmp"
          echo "✓ guard removed from $rc"
        done
        echo "› takes effect in new terminals"
        ;;
      status)
        on=0
        for rc in "${GUARD_RCS[@]}"; do [ -e "$rc" ] && grep -q '# airlock guard$' "$rc" && { echo "  ${G}on${N}   $rc"; on=1; }; done
        [ "$on" = 1 ] || echo "  ${Y}off${N}  turn on: airlock guard on"
        t="$HOME/.config/airlock/trusted"
        if [ -s "$t" ]; then echo "  ${B}trusted on the Mac${N} ${DIM}(guard skips these — edit $t)${N}"; sed 's/^/    /' "$t"; fi
        ;;
      *) echo "usage: airlock guard [on|off|status]"; exit 1 ;;
    esac
    ;;
  logs)
    set_identity
    cid="$(proxy_cid || true)"
    if [ -z "${cid:-}" ]; then echo "✗ no proxy running for this project"; exit 1; fi
    docker logs -f "$cid"
    ;;

  help|-h|--help) print_help ;;
  *) echo "unknown command: $cmd"; echo "try: airlock --help"; exit 1 ;;
esac
